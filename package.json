{
  "name": "ios-sim-stream",
  "productName": "Sim Relay",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "A desktop workspace for iOS simulators on another Mac.",
  "author": "Sim Relay contributors",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 0.0.0.0",
    "host": "tsx src/host/cli.ts",
    "web": "tsx src/web/cli.ts",
    "build": "tsc --noEmit && vite build && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.*",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir",
    "format": "prettier --write src scripts *.json *.ts *.html *.md .github docs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "bonjour-service": "^1.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "dev.simrelay.desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "src/host/idb.proto",
      "package.json",
      "assets/app-icon.png",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asarUnpack": [
      "src/host/idb.proto"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Sim Relay finds Macs on your network and connects to their iOS simulators.",
        "NSBonjourServices": [
          "_simrelay._tcp"
        ]
      },
      "artifactName": "Sim-Relay-${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "13.0",
      "entitlements": "packaging/entitlements.mac.plist",
      "entitlementsInherit": "packaging/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "dist-host",
          "to": "host"
        },
        {
          "from": "packaging/macos/sim-relay-host",
          "to": "bin/sim-relay-host"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Sim-Relay-${version}-windows-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "maintainer": "Nailington <Nailington@users.noreply.github.com>",
      "syncDesktopName": true,
      "artifactName": "Sim-Relay-${version}-linux-${arch}.${ext}"
    },
    "icon": "assets/app-icon.png",
    "deb": {
      "packageName": "sim-relay"
    },
    "rpm": {
      "packageName": "sim-relay"
    }
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "desktopName": "dev.simrelay.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nailington/sim-relay.git"
  },
  "homepage": "https://github.com/Nailington/sim-relay"
}
